# Copy to .dev.vars for `npm run dev`. Do not commit .dev.vars.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEWS_API_KEY=
FMP_API_KEY=
ANTHROPIC_API_KEY=
# Web Push (punto 12, reemplaza WhatsApp para alertas). Genera una sola vez con
# `npx web-push generate-vapid-keys`. La privada solo la usa Python (GitHub Actions), nunca
# el navegador ni ningún archivo servido al público.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
