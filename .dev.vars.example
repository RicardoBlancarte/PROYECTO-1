# Copy to .dev.vars for `npm run dev`. Do not commit .dev.vars.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEWS_API_KEY=
FMP_API_KEY=
ANTHROPIC_API_KEY=
# Web Push (punto 12, reemplaza WhatsApp para alertas). Genera una sola vez con
# `npx web-push generate-vapid-keys`. La privada solo la usa Python (GitHub Actions), nunca
# el navegador ni ningún archivo servido al público.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Parche interino de acceso para los endpoints de solo-lectura del panel de superadmin
# (winrate, winrate-shadow, admin/metrics, GET de track-view). Si se deja vacía, esos
# endpoints se quedan abiertos como hoy. El valor se captura del mismo password que ya se
# teclea al entrar como superadmin (ver admin-go en index.html) y se envía como header
# X-Admin-Secret; no es autenticación real, ver functions/_shared/admin-auth.js.
ADMIN_API_SECRET=
